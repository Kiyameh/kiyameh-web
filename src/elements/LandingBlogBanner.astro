---
import TagTitle from "@/components/ui/TagTitle/TagTitle";

interface BlogBannerProps {
  language: "en" | "es";
}

const { language = "es" } = Astro.props as BlogBannerProps;

const TEXTS = {
  en: {
    text: "Before you go, don't forget to visit my blog, recently opened and where I will be sharing some ideas and useful components that can help you in your project.",
    link: "Blog",
  },
  es: {
    text: "Antes de irte, no olvides visitar mi blog, abierto recientemente y donde iré compartiendo algunas ideas y componentes utiles que pueden ayudarte en tu proyecto.",
    link: "Blog",
  },
};
---

<div class="container">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="68"
    height="68"
    viewBox="0 0 24 24"
    fill="none"
    stroke="var(--content)"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="blog-icon"
    ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
      d="M2 20a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1"
    ></path><path d="M4 18l-1 -3h18l-1 3"></path><path d="M11 12h7l-7 -9v9"
    ></path><path d="M8 7l-2 5"></path></svg
  >
  <div>
    <p>{TEXTS[language].text}</p>
    <br />
    <a class="link big-link" href={`/${language}/blog`}
      >{TEXTS[language].link}</a
    >
  </div>
</div>

<style>
  .container {
    width: 100%;
    max-width: 840px;
    margin: 0 auto;
    padding: 2rem;
    border-radius: var(--radius-large);
    background-color: var(--surface-300);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  .blog-icon {
    flex-shrink: 0;
  }

  .big-link {
    font-size: 1.3rem;
  }
</style>
