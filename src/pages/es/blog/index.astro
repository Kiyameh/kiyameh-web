---
import { getCollection } from "astro:content";
import HtmlLayout from "@/layouts/HtmlLayout.astro";
import NavLayout from "@/layouts/NavLayout.astro";
import waves from "@/assets/backgrounds/waves.svg";
import { Calendar, User, Tag } from "lucide-react";
import { formatDateShort } from "@/utils/dateUtils";
import sailboat from "@/assets/sailboat.svg";
import Grapper from "@/components/package/Grapper";

const posts = await getCollection("posts");
/* Ignorar los post en borrador (draft) */
const publishedPosts = posts.filter((post) => !post.data.draft);
const sortedPosts = publishedPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<HtmlLayout
  pageTitle="Blog"
  pageTags={["blog", "articulos"]}
  pageDescription="Blog de ideas asombrosas"
>
  <NavLayout>
    <header>
      <img class="background" src={waves.src} alt="" />
      <h1>
        <span>Diario de viaje</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="68"
          height="68"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--content)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M2 20a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1"
          ></path><path d="M4 18l-1 -3h18l-1 3"></path><path
            d="M11 12h7l-7 -9v9"></path><path d="M8 7l-2 5"></path></svg
        >
      </h1>
    </header>

    <main class="blog-main">
      <div class="posts-container">
        {
          sortedPosts.length === 0 ? (
            <div class="no-posts">
              <p>No hay posts disponibles aún.</p>
            </div>
          ) : (
            <div class="posts-grid">
              {sortedPosts.map((post) => (
                <Grapper client:load mode="ghost" variant="sticky">
                  <article class="post-card">
                    <a href={`/es/blog/${post.id}`}>
                      <div class="post-card-content">
                        <div class="post-meta">
                          <span class="post-date">
                            <Calendar size={16} color="var(--gradient-200)" />
                            {formatDateShort(post.data.pubDate)}
                          </span>
                          <span class="post-author">
                            <User size={16} color="var(--gradient-200)" />
                            {post.data.author}
                          </span>
                        </div>

                        <h2 class="post-title">{post.data.title}</h2>

                        {post.data.description && (
                          <p class="post-description">
                            {post.data.description}
                          </p>
                        )}

                        <div class="post-tags">
                          <Tag size={14} color="var(--gradient-200)" />
                          <div class="tags-list">
                            {post.data.tags.slice(0, 3).map((tag) => (
                              <span class="tag">{tag}</span>
                            ))}
                            {post.data.tags.length > 3 && (
                              <span class="tag-more">
                                +{post.data.tags.length - 3}
                              </span>
                            )}
                          </div>
                        </div>
                        <div>
                          <p class="link">Leer artículo →</p>
                        </div>
                      </div>
                    </a>
                  </article>
                </Grapper>
              ))}
            </div>
          )
        }
      </div>
    </main>
  </NavLayout>
</HtmlLayout>

<style>
  header {
    width: 100%;
    height: 60svh;
    overflow: hidden;
  }

  .background {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  header h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--content);
    font-size: 3rem;
    text-align: center;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .blog-main {
    min-height: 40svh;
    padding-bottom: 6rem;
  }

  .posts-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .no-posts {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--content);
    font-size: 1.125rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .post-card {
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-medium);
    transition: all 0.3s ease;
  }

  .post-card-content {
    padding: 2rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--content-soft);
  }

  .post-date,
  .post-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--content);
    flex-grow: 0;
  }

  .post-description {
    color: var(--content-soft);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--content-soft);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: var(--surface-300);
    color: var(--content-soft);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-medium);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .tag-more {
    background: var(--surface-300);
    color: var(--content-soft);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-medium);
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    header h1 {
      font-size: 2rem;
      padding: 0 1rem;
    }

    .posts-container {
      padding: 2rem 1rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .post-card-content {
      cursor: pointer;
      padding: 1.5rem;
    }

    .post-title {
      font-size: 1.25rem;
    }

    .post-meta {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .blog-main {
      margin-top: 60svh;
    }

    .posts-container {
      padding: 1.5rem 0.75rem;
    }

    .post-card-content {
      padding: 1.25rem;
    }
  }
</style>
